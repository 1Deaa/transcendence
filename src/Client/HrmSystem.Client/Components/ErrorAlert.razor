@*
    //?     Friendly load-failure state with a retry action — replaces unhandled exceptions
    //?     (and the yellow "Reload" crash bar) everywhere a page talks to the API.
*@
@if (Message is not null)
{
    <div class="alert alert-danger d-flex align-items-center justify-content-between flex-wrap gap-2" role="alert">
        <span><i class="ti ti-alert-circle me-2"></i>@Message</span>
        @if (OnRetry.HasDelegate)
        {
            <button class="btn btn-sm btn-outline-danger" @onclick="OnRetry">
                <i class="ti ti-refresh me-1"></i>Try again
            </button>
        }
    </div>
}

@code {
    [Parameter]
    public string? Message { get; set; }

    [Parameter]
    public EventCallback OnRetry { get; set; }
}
