@implements IAsyncDisposable
@inject IJSRuntime Js

@*
    //?     Generic ApexCharts host: give it a ChartId and an anonymous-object Options graph;
    //?     it serializes to JSON and hands off to js/apex-interop.js (ES module).
    //>       <ApexChart ChartId="attendanceTrend" Options="@_options" />
    //!     Options must be re-assigned (new object) to re-render — mutation is invisible here.
*@
<div id="@ChartId"></div>

@code {
    private IJSObjectReference? _module;
    private object? _renderedOptions;

    [Parameter, EditorRequired]
    public string ChartId { get; set; } = string.Empty;

    [Parameter]
    public object? Options { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await Js.InvokeAsync<IJSObjectReference>(
                "import",
                "./js/apex-interop.js"
            );
        }

        if (_module is not null && Options is not null && !ReferenceEquals(Options, _renderedOptions))
        {
            _renderedOptions = Options;
            string optionsJson = System.Text.Json.JsonSerializer.Serialize(
                Options,
                JsonOptions
            );
            await _module.InvokeVoidAsync("render", ChartId, optionsJson);
        }
    }

    private static readonly System.Text.Json.JsonSerializerOptions JsonOptions = new()
    {
        PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase,
    };

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("destroy", ChartId);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                //? Page torn down first — nothing left to clean up in the browser.
            }
        }
    }
}
