@page "/health"
@attribute [Authorize]
@inject HttpClient Http

<PageTitle>System health — HrmSystem</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-1">System health</h4>
        <span class="text-muted">Component detail (authenticated view)</span>
    </div>
    <button class="btn btn-sm btn-primary" @onclick="LoadAsync" disabled="@_loading">
        <i class="ti ti-refresh me-1"></i>Refresh
    </button>
</div>

@if (_components is null)
{
    <div class="d-flex justify-content-center p-5">
        <div class="spinner-border text-primary" role="status"></div>
    </div>
}
else if (_forbidden)
{
    <div class="alert alert-warning">Your account does not have permission to view component health.</div>
}
else
{
    <div class="card">
        <div class="table-responsive text-nowrap">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Component</th>
                        <th>Status</th>
                        <th>Duration</th>
                        <th>Description</th>
                        <th>Checked at</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (ComponentHealthResponse component in _components)
                    {
                        <tr>
                            <td class="fw-medium">@component.Name</td>
                            <td><span class="badge bg-label-@StatusColor(component.Status)">@component.Status</span></td>
                            <td>@component.DurationMs.ToString("0") ms</td>
                            <td class="text-wrap">@(component.Description ?? "—")</td>
                            <td>@component.CheckedAtUtc.ToLocalTime().ToString("g")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private IReadOnlyList<ComponentHealthResponse>? _components;
    private bool _loading;
    private bool _forbidden;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _forbidden = false;

        try
        {
            using HttpResponseMessage response = await Http.GetAsync("api/status/components");
            if (response.StatusCode == System.Net.HttpStatusCode.Forbidden)
            {
                _forbidden = true;
                _components = [];
                return;
            }

            response.EnsureSuccessStatusCode();
            _components =
                await response.Content.ReadFromJsonAsync<IReadOnlyList<ComponentHealthResponse>>()
                ?? [];
        }
        finally
        {
            _loading = false;
        }
    }

    private static string StatusColor(string status) =>
        status switch
        {
            "Healthy" => "success",
            "Degraded" => "warning",
            _ => "danger",
        };
}
