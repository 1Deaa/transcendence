@page "/login"
@layout PublicLayout
@inject AuthService Auth
@inject NavigationManager Navigation

<PageTitle>Sign in — HrmSystem</PageTitle>

@*
    //?     Vuexy auth-login-basic design: brand, headline, floating card, password
    //?     visibility toggle, demo-workspace hint for the seeded environment.
*@
<div class="card px-sm-6 px-0 mx-auto shadow-sm" style="max-width: 440px;">
    <div class="card-body">
        <div class="app-brand justify-content-center mb-4 mt-2">
            <span class="app-brand-logo me-2">
                <svg width="36" height="25" viewBox="0 0 32 22" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path fill-rule="evenodd" clip-rule="evenodd"
                          d="M0.00172773 0V6.85398C0.00172773 6.85398 -0.133178 9.01207 1.98092 10.8388L13.6912 21.9964L19.7809 21.9181L18.8042 9.88248L16.4951 7.17289L9.23799 0H0.00172773Z"
                          fill="#7367F0" />
                    <path opacity="0.06" fill-rule="evenodd" clip-rule="evenodd"
                          d="M7.69824 16.4364L12.5199 3.23696L16.5541 7.25596L7.69824 16.4364Z" fill="#161616" />
                    <path opacity="0.06" fill-rule="evenodd" clip-rule="evenodd"
                          d="M8.07751 15.9175L13.9419 4.63989L16.5849 7.28475L8.07751 15.9175Z" fill="#161616" />
                    <path fill-rule="evenodd" clip-rule="evenodd"
                          d="M7.77295 16.3566L23.6563 0H32V6.88383C32 6.88383 31.8262 9.17836 30.6591 10.4057L19.7824 22H13.6938L7.77295 16.3566Z"
                          fill="#7367F0" />
                </svg>
            </span>
            <span class="app-brand-text fw-bold fs-3">HrmSystem</span>
        </div>

        <h4 class="mb-1">Welcome to HrmSystem 👋</h4>
        <p class="mb-4 text-muted">Sign in to your company workspace.</p>

        @if (_error is not null)
        {
            <div class="alert alert-danger d-flex align-items-center" role="alert">
                <i class="ti ti-alert-circle me-2"></i>@_error
            </div>
        }

        <EditForm Model="_model" OnValidSubmit="SubmitAsync">
            <div class="mb-4">
                <label class="form-label" for="identifier">Username or email</label>
                <InputText id="identifier" class="form-control" @bind-Value="_model.Identifier"
                           placeholder="admin-acme" autocomplete="username" />
            </div>
            <div class="mb-4 form-password-toggle">
                <label class="form-label" for="password">Password</label>
                <div class="input-group input-group-merge">
                    <InputText id="password" type="@(_showPassword ? "text" : "password")"
                               class="form-control" @bind-Value="_model.Password"
                               placeholder="············" autocomplete="current-password" />
                    <span class="input-group-text cursor-pointer" @onclick="() => _showPassword = !_showPassword"
                          role="button" title="@(_showPassword ? "Hide password" : "Show password")"
                          aria-label="@(_showPassword ? "Hide password" : "Show password")">
                        <i class="ti @(_showPassword ? "ti-eye" : "ti-eye-off")"></i>
                    </span>
                </div>
            </div>
            <button class="btn btn-primary d-grid w-100 mb-2" type="submit" disabled="@_busy">
                @if (_busy)
                {
                    <span><span class="spinner-border spinner-border-sm me-2" role="status"></span>Signing in…</span>
                }
                else
                {
                    <span>Sign in</span>
                }
            </button>
        </EditForm>

        <div class="alert alert-secondary mt-4 mb-2 py-2 px-3">
            <small class="d-block fw-medium mb-1"><i class="ti ti-info-circle me-1"></i>Demo workspaces</small>
            <small class="text-muted d-block">
                <code>admin-acme</code>, <code>manager-acme</code>, <code>employee-acme</code>
                (also <code>-globex</code>, <code>-initech</code>) — password <code>Seed1234</code>
            </small>
        </div>

        <div class="text-center mt-3 mb-2">
            <span class="small text-muted">New company? </span>
            <a href="/#register" class="small fw-medium">Create your workspace</a>
            <span class="small text-muted mx-1">·</span>
            <a href="status" class="small"><i class="ti ti-broadcast me-1"></i>System status</a>
        </div>
        <div class="text-center mb-1">
            <a href="privacy" class="small text-muted">Privacy Policy</a>
            <span class="small text-muted mx-1">·</span>
            <a href="terms" class="small text-muted">Terms of Service</a>
        </div>
    </div>
</div>

@code {
    private readonly LoginModel _model = new();
    private bool _busy;
    private bool _showPassword;
    private string? _error;

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private async Task SubmitAsync()
    {
        _busy = true;
        _error = null;

        try
        {
            bool succeeded = await Auth.LoginAsync(_model.Identifier, _model.Password);
            if (!succeeded)
            {
                _error = "Sign-in failed. Check your credentials and try again.";
                return;
            }

            string target = string.IsNullOrWhiteSpace(ReturnUrl) ? "dashboard" : ReturnUrl;
            Navigation.NavigateTo(target);
        }
        catch (HttpRequestException)
        {
            _error = "Cannot reach the server. Please try again in a moment.";
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed class LoginModel
    {
        public string Identifier { get; set; } = string.Empty;

        public string Password { get; set; } = string.Empty;
    }
}
