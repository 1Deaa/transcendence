<Project>
	<!--//? Nested Directory.Build.props does NOT chain automatically — import the root one explicitly. -->
	<Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)..'))" />

	<PropertyGroup>
		<IsPackable>false</IsPackable>
		<!--
			//?		Test-code carve-outs from the strict analyzer set:
			//?		 - CA1707: test method names use underscores (Given_When_Then style).
			//?		 - CA1515: xUnit test classes must stay public for discovery.
			//?		 - CA2007: ConfigureAwait(false) is noise inside test methods.
		-->
		<NoWarn>$(NoWarn);CA1707;CA1515;CA2007</NoWarn>
	</PropertyGroup>
</Project>
